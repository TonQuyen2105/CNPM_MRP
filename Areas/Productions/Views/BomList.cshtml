@{
    Layout = null;
    ViewData["Title"] = "AMIS Sản xuất - Định mức nguyên vật liệu (BOM)";
}

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"]</title>
  
  <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/productions/production-order.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/productions/bom.css" asp-append-version="true" />
</head>
<body>
  <div class="app-wrapper">
    <header class="app-header">
      <div class="header-left">
        <button type="button" class="btn-sidebar-toggle" id="sidebarToggleBtn" title="Đóng/Mở menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <div class="app-brand">
          <div class="app-brand-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 20h20"></path>
              <path d="M5 20V8l5 4V8l5 4V4h4v16"></path>
            </svg>
          </div>
          <span class="app-brand-name">Sản xuất</span>
        </div>
      </div>
      <div class="header-right">
        <div class="branch-selector" title="Chọn chi nhánh làm việc">
          <span>Chi nhánh:</span>
          <strong>Công ty cơ khí Kim Khí Miền Nam</strong>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
        <div class="header-actions">
          <button type="button" class="icon-btn" title="Cài đặt hệ thống"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg></button>
          <button type="button" class="icon-btn" title="Trợ giúp & Hướng dẫn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></button>
          <button type="button" class="icon-btn" title="Thông báo"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg><span class="badge-dot"></span></button>
        </div>
        <div class="user-profile"><div class="user-avatar">NV</div><span class="user-name">Nguyễn Văn Dev</span></div>
      </div>
    </header>

    <aside class="app-sidebar" id="appSidebar">
      <div class="sidebar-nav-container">
        <div class="nav-item"><a asp-action="Index" class="nav-link"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a10 10 0 0 1 10 10H12V2z"></path></svg></span><span class="nav-text">Tổng quan</span></a></div>
        <div class="nav-item"><a href="#" class="nav-link"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg></span><span class="nav-text">Đơn đặt hàng</span></a></div>
        <div class="nav-item has-sub"><a href="#" class="nav-link"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg></span><span class="nav-text">Kế hoạch sản xuất</span></a></div>
        <div class="nav-item has-sub"><a href="#" class="nav-link"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg></span><span class="nav-text">Điều phối & thực thi</span></a>
          <div class="sub-menu">
            <a asp-action="ProductionOrder" class="sub-link">Lệnh sản xuất</a>
          </div>
        </div>
        <div class="nav-item"><a href="#" class="nav-link"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg></span><span class="nav-text">Kiểm tra chất lượng</span></a></div>
        <div class="nav-section-title">QUẢN TRỊ & BÁO CÁO</div>
        <div class="nav-item"><a href="#" class="nav-link"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg></span><span class="nav-text">Sản phẩm, NVL</span></a></div>
        <div class="nav-item"><a asp-action="BomList" class="nav-link active"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg></span><span class="nav-text">Định mức NVL (BOM)</span></a></div>
      </div>
      <div class="sidebar-footer">
        <button type="button" class="btn-collapse-sidebar" id="sidebarCollapseBtn"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="11 17 6 12 11 7"></polyline><polyline points="18 17 13 12 18 7"></polyline></svg><span class="collapse-text">Thu gọn menu</span></button>
      </div>
    </aside>

    <main class="app-main">
      <div class="main-container page-fade-in">
        <div class="bom-list-header">
          <h1 class="bom-page-title">Định mức nguyên vật liệu (BOM)</h1>
          <div class="bom-header-right">
            <a asp-action="BomCreate" class="btn-add-bom">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              + Thêm định mức
            </a>
          </div>
        </div>

        <div class="bom-filter-bar">
          <div class="search-input-wrap">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="bomSearchInput" class="search-input" placeholder="Tìm kiếm theo mã BOM, tên BOM, sản phẩm...">
          </div>
        </div>

        <div class="bom-form-card">
          <div class="table-responsive">
            <table class="bom-table">
              <thead>
                <tr>
                  <th class="text-center" style="width: 50px;">STT</th>
                  <th>Mã BOM</th>
                  <th>Tên BOM</th>
                  <th>Sản phẩm</th>
                  <th>Phiên bản</th>
                  <th>Loại BOM</th>
                  <th>ĐVT</th>
                  <th class="text-right">Số lượng</th>
                  <th>Hiệu lực</th>
                  <th class="text-center">Trạng thái</th>
                  <th class="text-center" style="width: 90px;">Thao tác</th>
                </tr>
              </thead>
              <tbody id="bomListTableBody">
                <tr>
                  <td class="text-center">1</td>
                  <td><strong>BOM_SIRO</strong></td>
                  <td>Định mức nguyên vật liệu sản xuất Siro ho, bổ phế</td>
                  <td>SIRO - Siro ho, bổ phế</td>
                  <td>Ver 2</td>
                  <td>BOM sản xuất</td>
                  <td>ml</td>
                  <td class="text-right">1.000,0000</td>
                  <td>15/01/2026</td>
                  <td class="text-center"><span class="badge-status-active">Đang sử dụng</span></td>
                  <td class="text-center">
                    <a asp-action="BomEdit" class="btn-edit-action" title="Sửa định mức BOM">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    </a>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script src="~/js/app.js" asp-append-version="true"></script>
  <script src="~/js/productions/bom.js" asp-append-version="true"></script>
</body>
</html>
