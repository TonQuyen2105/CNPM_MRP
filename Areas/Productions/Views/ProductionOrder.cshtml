                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                  </span>
                </div>
              </div>

              <div class="form-group">
                <label class="form-label">Bắt đầu <span class="required-mark">*</span></label>
                <div class="form-control-wrap">
                  <input type="text" class="form-input has-calendar" value="22/01/2026 23:59">
                  <span class="calendar-icon-btn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                  </span>
                </div>
              </div>

              <div class="form-group">
                <label class="form-label">Kết thúc <span class="required-mark">*</span></label>
