              </div>

              <div class="table-footer-right">
                <span>Số dòng/trang</span>
                <select class="form-select" style="width: 75px; height: 26px; padding: 0 4px; font-size: 12px;">
                  <option selected>100</option>
                  <option>50</option>
                  <option>20</option>
                </select>
                <span>1 - 4</span>
                <button type="button" class="pagination-btn" title="Trang trước">&lt;</button>
                <button type="button" class="pagination-btn" title="Trang sau">&gt;</button>
              </div>
            </div>

            <div class="sample-data-stamp">
              <div class="stamp-inner">
                DỮ LIỆU MẪU
              </div>
            </div>

          </div>

        </div>

        <div class="order-bottom-actions">
          <button type="button" class="btn-cancel" id="btnCancelOrder">Hủy</button>
          <button type="button" class="btn-save-draft">Lưu nháp</button>
          <button type="button" class="btn-save-submit" id="btnSubmitOrder">Lưu Lệnh sản xuất</button>
        </div>

      </div>
    </main>

  </div>

  <script src="~/js/app.js" asp-append-version="true"></script>
  <script src="~/js/productions/production-order.js" asp-append-version="true"></script>
</body>
</html>
