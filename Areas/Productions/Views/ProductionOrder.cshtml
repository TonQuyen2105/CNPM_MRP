                <thead>
                  <tr>
                    <th class="text-center" style="width: 45px;">STT</th>
                    <th>Mã nguyên vật liệu</th>
                    <th>Tên nguyên vật liệu</th>
                    <th>Tính chất</th>
                    <th class="text-center" style="width: 130px;">Tự động lập lệnh SX</th>
                    <th>Tên công đoạn</th>
                    <th>ĐVT</th>
                    <th class="text-center">Là NVL chính ⓘ</th>
                    <th class="text-right">Định mức theo BOM ⓘ</th>
                    <th class="text-right">SL theo định mức</th>
                    <th class="text-center" style="width: 70px;">Thao tác</th>
                  </tr>
                </thead>
                <tbody id="bomTableBody">
                  <tr>
                    <td class="text-center col-stt">1</td>
                    <td><strong>NUOCCAT</strong></td>
                    <td>Nước cất</td>
                    <td>Nguyên vật liệu</td>
                    <td class="text-center"><input type="checkbox"></td>
                    <td>-</td>
                    <td>ml</td>
                    <td class="text-center"><input type="checkbox"></td>
                    <td class="text-right">650,0000</td>
                    <td class="text-right"><strong>1.300,000</strong></td>
                    <td class="text-center">
                      <div class="row-actions-cell">
                        <button type="button" class="row-act-btn btn-delete-row" title="Xóa dòng">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>

                  <tr>
                    <td class="text-center col-stt">2</td>
                    <td><strong>GLUCO</strong></td>
                    <td>Đường trắng/glucose</td>
                    <td>Nguyên vật liệu</td>
                    <td class="text-center"><input type="checkbox"></td>
                    <td>-</td>
                    <td>g</td>
                    <td class="text-center"><input type="checkbox"></td>
                    <td class="text-right">500,0000</td>
                    <td class="text-right"><strong>1.000,000</strong></td>
                    <td class="text-center">
                      <div class="row-actions-cell">
                        <button type="button" class="row-act-btn btn-delete-row" title="Xóa dòng">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>

                  <tr>
                    <td class="text-center col-stt">3</td>
                    <td><strong>GLY</strong></td>
                    <td>Glycerin/sorbitol</td>
                    <td>Nguyên vật liệu</td>
                    <td class="text-center"><input type="checkbox"></td>
                    <td>-</td>
                    <td>ml</td>
                    <td class="text-center"><input type="checkbox"></td>
                    <td class="text-right">45,0000</td>
                    <td class="text-right"><strong>90,000</strong></td>
                    <td class="text-center">
                      <div class="row-actions-cell">
                        <button type="button" class="row-act-btn btn-delete-row" title="Xóa dòng">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>

                  <tr>
                    <td class="text-center col-stt">4</td>
                    <td><strong>AXIT</strong></td>
                    <td>Acid citric</td>
                    <td>Nguyên vật liệu</td>
                    <td class="text-center"><input type="checkbox"></td>
                    <td>-</td>
                    <td>g</td>
                    <td class="text-center"><input type="checkbox"></td>
                    <td class="text-right">3,0000</td>
                    <td class="text-right"><strong>6,000</strong></td>
                    <td class="text-center">
                      <div class="row-actions-cell">
                        <button type="button" class="row-act-btn btn-delete-row" title="Xóa dòng">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="table-footer-bar">
              <div class="table-footer-left">
                <span>Tổng số: <strong id="totalRowsCount">4</strong></span>
                <button type="button" class="btn-table-action btn-add-row" id="btnAddRow">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                  Thêm dòng
                </button>
                <button type="button" class="btn-table-action btn-clear-rows" id="btnClearRows">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>
