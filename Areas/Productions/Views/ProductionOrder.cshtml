                  <input type="text" class="form-input has-calendar" value="30/01/2026 23:59">
                  <span class="calendar-icon-btn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                  </span>
                </div>
              </div>
            </div>
          </div>

          <div class="tabs-section-card">
            <div class="order-tabs-bar">
              <span class="order-tab-link active">Chi tiết nguyên vật liệu</span>
              <span class="order-tab-link">Công đoạn sản xuất</span>
              <span class="order-tab-link">Phụ phẩm</span>
              <span class="order-tab-link">Tệp đính kèm (0)</span>
            </div>

            <div class="tab-toolbar">
              <span>Được tính toán dựa trên số lượng sản phẩm và BOM hoặc có thể khai báo thủ công</span>
              
              <div class="tab-toolbar-actions">
                <span class="tab-action-btn">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                  </svg>
                  Lấy tồn kho NVL
                </span>
                <span class="tab-action-btn">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                  </svg>
                  Lấy lại theo BOM
